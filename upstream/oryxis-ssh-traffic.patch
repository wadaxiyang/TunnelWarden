--- a/Cargo.toml
+++ b/Cargo.toml
@@ -2,18 +2,20 @@
 name = "oryxis-ssh"
 version = "0.1.0"
 edition = "2024"
+license = "AGPL-3.0-or-later"
+repository = "https://github.com/wilsonglasser/oryxis"
 
 [dependencies]
-oryxis-core = { workspace = true }
-russh = { workspace = true }
+oryxis-core = { git = "https://github.com/wilsonglasser/oryxis.git", rev = "16ad2af83b424780ff60b6420a6c20a3b30c7143" }
+russh = { version = "0.62.5", features = ["des"] }
 russh-sftp = "2.4"
-tokio = { workspace = true }
-tracing = { workspace = true }
-thiserror = { workspace = true }
+tokio = { version = "1", features = ["full"] }
+tracing = "0.1"
+thiserror = "2"
 tokio-socks = "0.5"
-uuid = { workspace = true }
+uuid = { version = "1", features = ["v4", "serde"] }
 # HTTP CONNECT Proxy-Authorization: Basic header
-base64 = { workspace = true }
+base64 = "0.23"
 # Per-host terminal encoding: transcode PTY bytes <-> UTF-8 for non-UTF-8
 # charsets (Big5, Shift-JIS, CP437, ...). UTF-8 hosts skip it entirely.
 encoding_rs = "0.8"
@@ -74,5 +76,8 @@
 tempfile = "3"
 # Surfaces the engine's own tracing in the live X11 test, where the log
 # is the only evidence of which forwarding branch was taken.
-tracing-subscriber = { workspace = true }
-tokio = { workspace = true, features = ["full", "test-util"] }
+tracing-subscriber = { version = "0.3", features = ["env-filter"] }
+tokio = { version = "1", features = ["full", "test-util"] }
+
+# Isolated dependency workspace: retain upstream tests without adding them to the app gates.
+[workspace]
